<%= tag.div(class: classes, role: "alert", data: stimulus_data) do %>
  <%= heroicon(icon, variant: @title ? :outline : :solid, options: { class: icon_classes }) %>
  <span class="lui:sr-only"><%= @type.to_s.humanize %></span>
  <% if @title %>
    <h5 class="<%= title_classes %>"><%= @title %></h5>
    <div class="lui:text-foreground-secondary"><%= content %></div>
    <% if footer.present? %>
      <div class="lui:mt-3">
        <%= footer %>
      </div>
    <% end %>
  <% else %>
    <%= content %>
  <% end %>
  <% if dismissible? %>
    <button type="button" data-action="lui-alert#close" aria-label="Dismiss" class="<%= dismiss_button_classes %>">
      <%= heroicon("x-mark", variant: :outline, options: { class: "lui:size-4" }) %>
    </button>
  <% end %>
<% end %>
