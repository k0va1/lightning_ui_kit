<%= tag.div(data: data) do %>
  <% if trigger? %>
    <div data-action="click->lui-alert-dialog#open" class="lui:inline-block lui:cursor-pointer">
      <%= trigger %>
    </div>
  <% end %>

  <dialog
    id="<%= @id %>"
    role="alertdialog"
    data-lui-alert-dialog-target="dialog"
    data-lui-alert-dialog-panel-closed-class="<%= panel_closed_class %>"
    data-lui-alert-dialog-overlay-closed-class="<%= overlay_closed_class %>"
    class="lui:fixed lui:inset-0 lui:m-0 lui:h-full lui:max-h-none lui:w-full lui:max-w-none lui:overflow-hidden lui:bg-transparent lui:backdrop:bg-transparent"
  >
    <div
      data-lui-alert-dialog-target="overlay"
      class="lui:fixed lui:inset-0 lui:bg-surface-overlay lui:transition-opacity lui:duration-200 <%= overlay_closed_class %>"
    ></div>

    <div class="lui:fixed lui:inset-0 lui:flex lui:items-center lui:justify-center lui:p-4">
      <div
        data-lui-alert-dialog-target="panel"
        class="lui:relative lui:z-50 lui:flex lui:w-full lui:max-w-lg lui:flex-col lui:gap-4 lui:rounded-xl lui:border lui:border-border lui:bg-surface lui:p-6 lui:text-foreground lui:shadow-lg lui:transition-all lui:duration-200 lui:ease-out <%= panel_closed_class %>"
      >
        <div class="lui:flex lui:flex-col lui:gap-2">
          <h2 class="lui:text-lg lui:font-semibold lui:text-foreground"><%= title %></h2>
          <% if description %>
            <p class="lui:text-sm lui:text-foreground-muted"><%= description %></p>
          <% end %>
        </div>

        <% if body? %>
          <div class="lui:text-sm lui:text-foreground-secondary"><%= body %></div>
        <% end %>

        <div class="lui:mt-2 lui:flex lui:flex-col-reverse lui:gap-2 lui:sm:flex-row lui:sm:justify-end">
          <button type="button" data-action="click->lui-alert-dialog#close" class="<%= cancel_button_classes %>">
            <%= cancel_text %>
          </button>
          <% if confirm? %>
            <%= confirm %>
          <% else %>
            <button type="button" data-action="click->lui-alert-dialog#confirm" class="<%= confirm_button_classes %>">
              <%= confirm_text %>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </dialog>
<% end %>
