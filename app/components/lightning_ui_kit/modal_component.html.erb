<%= tag.div(id: @id, data: data) do %>
  <% if trigger? %>
    <div data-action="click->lui-modal#open" class="lui:inline-block lui:cursor-pointer">
      <%= trigger %>
    </div>
  <% end %>

  <%= tag.dialog(role: dialog_role, data: {lui_modal_target: "dialog"}, class: "lui:fixed lui:inset-0 lui:m-0 lui:h-full lui:max-h-none lui:w-full lui:max-w-none lui:overflow-hidden lui:bg-transparent lui:backdrop:bg-transparent") do %>
    <div
      data-lui-modal-target="overlay"
      class="lui:fixed lui:inset-0 lui:bg-surface-overlay lui:transition-opacity lui:duration-200 <%= overlay_closed_class %>"
    ></div>
    <div class="lui:fixed lui:inset-0 lui:w-screen lui:overflow-y-auto lui:pt-6 lui:sm:pt-0">
      <div class="lui:grid lui:min-h-full lui:grid-rows-[1fr_auto] lui:justify-items-center lui:sm:grid-rows-[1fr_auto_3fr] lui:sm:p-4" data-action="click->lui-modal#closeOnBackdrop">
        <div class="lui:row-start-2 lui:w-full lui:min-w-0 lui:rounded-t-3xl lui:bg-surface-secondary lui:p-(--gutter) lui:ring-1 lui:shadow-lg lui:ring-border lui:[--gutter:--spacing(8)] lui:sm:mb-auto lui:sm:rounded-2xl lui:forced-colors:outline lui:transition-all lui:duration-200 lui:ease-out lui:will-change-transform <%= panel_width_class %> <%= panel_closed_class %>" data-lui-modal-target="panel">
          <% if @title %>
            <h2 class="lui:text-lg/6 lui:font-semibold lui:text-balance lui:text-foreground lui:sm:text-base/6">
              <%= @title %>
            </h2>
          <% end %>
          <% if @description %>
            <p data-slot="text" class="lui:mt-2 lui:text-pretty lui:text-base/6 lui:text-foreground-muted lui:sm:text-sm/6">
            <%= @description %>
            </p>
          <% end %>
          <%= body %>
          <% if alert? %>
            <div class="lui:mt-8 lui:flex lui:flex-col-reverse lui:items-center lui:justify-end lui:gap-3 *:lui:w-full lui:sm:flex-row lui:sm:*:w-auto">
              <%= render LightningUiKit::ButtonComponent.new(style: :outline, data: {action: "click->lui-modal#close"}).with_content(cancel_text) %>
              <% if confirm? %>
                <%= confirm %>
              <% else %>
                <%= render LightningUiKit::ButtonComponent.new(style: confirm_button_style, data: {action: "click->lui-modal#confirm"}).with_content(confirm_text) %>
              <% end %>
            </div>
          <% elsif actions.any? %>
            <div class="lui:mt-8 lui:flex lui:flex-col-reverse lui:items-center lui:justify-end lui:gap-3 *:lui:w-full lui:sm:flex-row lui:sm:*:w-auto">
              <% actions.each do |action| %>
                <%= action %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
