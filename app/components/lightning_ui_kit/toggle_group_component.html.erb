<%= tag.div(class: classes, data: data, role: "group") do %>
  <% items.each do |item| %>
    <button
      type="button"
      class="<%= item_classes %>"
      data-lui-toggle-group-target="item"
      data-value="<%= item.value %>"
      data-state="<%= state(item.value) %>"
      aria-pressed="<%= selected?(item.value) %>"
      data-action="click->lui-toggle-group#toggle"
    >
      <%= item %>
    </button>
  <% end %>
<% end %>
